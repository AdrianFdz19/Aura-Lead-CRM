generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @db.VarChar(255)
  slug            String           @unique @db.VarChar(100)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  subscription    Subscription?
  conversations   Conversation[]
  leads           Lead[]
  products        Product[]
  tasks           Task[]
  users           User[]
  whatsappConfig  WhatsappConfig?
  properties      Property[]
  tenantLlmConfig TenantLlmConfig?

  @@map("tenants")
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  PENDING
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
}

model Property {
  id          String       @id @default(uuid())
  title       String
  description String
  price       Decimal
  location    String
  images      String[]     @default([])
  type        PropertyType @default(HOUSE)

  // Nuevos campos
  status     PropertyStatus @default(AVAILABLE)
  leads      Int            @default(0)
  commission Decimal        @default(0)

  embedding Unsupported("vector(1536)")?

  isProtected Boolean @default(false) @map("is_protected")

  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now())

  // Si borras el Tenant, las propiedades se eliminan
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("properties")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String    @db.VarChar(255)
  avatar        String?
  email         String    @unique @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  passwordHash  String    @map("password_hash")
  role          Role      @default(AGENT)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  assignedLeads Lead[]    @relation("LeadAssignment")
  sentMessages  Message[]
  tasks         Task[]

  // Al borrar Tenant, se eliminan los usuarios
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Subscription {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @unique @map("tenant_id") @db.Uuid
  plan             String
  status           String
  stripeCustomerId String?

  // Al borrar Tenant, se elimina su suscripción
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

model Lead {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  waId           String       @unique @map("wa_id")
  tenantId       String       @map("tenant_id") @db.Uuid
  assignedToId   String?      @map("assigned_to_id") @db.Uuid
  name           String       @db.VarChar(255)
  email          String?      @db.VarChar(255)
  phone          String?      @db.VarChar(50)
  status         String       @default("nuevo") @db.VarChar(50)
  priority       LeadPriority @default(WARM)
  lastMessage    String?      @map("last_message") @db.Text
  customMetadata Json         @default("{}") @map("custom_metadata")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  isProtected   Boolean        @default(false) @map("is_protected")
  // Al borrar un Lead, se borran sus conversaciones, intereses y tareas asociadas
  conversations Conversation[]
  interests     LeadInterest[]
  tasks         Task[]

  assignedTo User?  @relation("LeadAssignment", fields: [assignedToId], references: [id], onDelete: SetNull)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model Conversation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  leadId        String   @unique @map("lead_id") @db.Uuid
  isOpen        Boolean  @default(true) @map("is_open")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  // Si borras el Lead o el Tenant, la conversación desaparece
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Si borras la conversación, se borran los mensajes
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  conversationId String     @map("conversation_id") @db.Uuid
  senderType     SenderType @map("sender_type")
  senderId       String?    @map("sender_id") @db.Uuid
  messageText    String     @map("message_text")
  metaMessageId  String?    @unique @map("meta_message_id")
  status         String     @default("sent")
  isProtected    Boolean    @default(false) @map("is_protected")
  createdAt      DateTime   @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@map("messages")
}

model WhatsappConfig {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @unique @map("tenant_id") @db.Uuid
  phoneNumberId        String   @map("phone_number_id")
  wabaId               String   @map("waba_id")
  accessTokenEncrypted String   @map("access_token_encrypted")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")
  phoneNumber          String   @map("phone_number")
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("whatsapp_configs")
}

model TenantLlmConfig {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @unique @map("tenant_id") @db.Uuid // <--- @unique fuerza que solo haya 1 por tenant
  provider        String @db.VarChar(50)
  modelName       String @map("model_name") @db.VarChar(100)
  apiKeyEncrypted String @map("api_key_encrypted") @db.Text

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_llm_configs")
}

model Product {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  title          String         @db.VarChar(255)
  price          Decimal        @db.Decimal(12, 2)
  status         String         @default("disponible") @db.VarChar(50)
  mediaUrls      String[]       @map("media_urls")
  customMetadata Json           @default("{}") @map("custom_metadata")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  interests      LeadInterest[]
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("products")
}

model LeadInterest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Si borras Lead o Producto, el interés ya no tiene sentido
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("lead_interests")
}

model Task {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  assignedToId String    @map("assigned_to_id") @db.Uuid
  leadId       String?   @map("lead_id") @db.Uuid
  title        String    @db.VarChar(255)
  description  String?
  dueDate      DateTime? @map("due_date")
  isCompleted  Boolean   @default(false) @map("is_completed")
  createdAt    DateTime  @default(now()) @map("created_at")

  assignedTo User   @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  lead       Lead?  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

enum Role {
  ADMIN
  AGENT
}

enum SenderType {
  LEAD
  AGENT
  SYSTEM
}
